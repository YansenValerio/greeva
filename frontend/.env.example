# ── API ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Midtrans ──────────────────────────────────────────────────────────────────
# Key di bawah adalah Sandbox — aman untuk development & staging.
# Ambil dari https://dashboard.midtrans.com → Settings → Access Keys (Client Key)
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=

# ── Cloudinary ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=greeva

# ── Meilisearch ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_MEILISEARCH_HOST=http://localhost:7700
NEXT_PUBLIC_MEILISEARCH_SEARCH_KEY=
