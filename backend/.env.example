APP_NAME=Greeva
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database ─────────────────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=greeva
DB_USERNAME=greeva
DB_PASSWORD=secret

# ── Cache & Queue ─────────────────────────────────────────────────────────────
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mail (Mailpit di development) ─────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@greeva.id"
MAIL_FROM_NAME="${APP_NAME}"

# ── Auth / Sanctum ────────────────────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost:3000

# ── Midtrans ─────────────────────────────────────────────────────────────────
# Ambil dari https://dashboard.midtrans.com → Settings → Access Keys
# Sandbox key: Mid-server-xxx (tanpa prefix SB- untuk akun lama) atau SB-Mid-server-xxx
# Production key: Mid-server-xxx, + ubah MIDTRANS_IS_PRODUCTION=true
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# ── Pengiriman / Ongkir ──────────────────────────────────────────────────────
# SHIPPING_PROVIDER: "mock" (kalkulasi lokal berbasis berat, default dev)
#                    atau "biteship" (API nyata — butuh BITESHIP_API_KEY).
# Jika "biteship" tapi API key kosong, otomatis fallback ke "mock".
SHIPPING_PROVIDER=mock
SHIPPING_ORIGIN_CITY=Bandung
SHIPPING_ORIGIN_POSTAL_CODE=40111
BITESHIP_API_KEY=
BITESHIP_BASE_URL=https://api.biteship.com
BITESHIP_COURIERS=jne,jnt,sicepat,anteraja

# ── Cloudinary ───────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=greeva
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# ── Meilisearch ──────────────────────────────────────────────────────────────
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=
SCOUT_DRIVER=meilisearch

# ── WhatsApp Notification ────────────────────────────────────────────────────
WHATSAPP_PROVIDER=fonnte
WHATSAPP_API_KEY=

# ── Greeva Business Config ────────────────────────────────────────────────────
GREEVA_DEFAULT_REVENUE_SHARE=80
GREEVA_COOLING_PERIOD_DAYS=7
GREEVA_DEFAULT_PAYOUT_PERIOD_DAYS=14
GREEVA_GUEST_CART_TTL_DAYS=30
GREEVA_ORDER_PAYMENT_EXPIRY_HOURS=24
